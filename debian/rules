#!/usr/bin/make -f
# Modern pybuild + PEP 517 (hatchling) packaging.

# Uncomment to trace every command.
#export DH_VERBOSE = 1

# pybuild detects the project name from pyproject.toml; we set
# PYBUILD_NAME explicitly because the distribution name on PyPI uses a
# dash but the importable module uses an underscore.
export PYBUILD_NAME=process_media

%:
	dh $@ --with python3 --buildsystem=pybuild

# Run the test suite from the build tree. Build profiles ``nocheck`` and
# ``DEB_BUILD_OPTIONS=nocheck`` already skip ``dh_auto_test``; this
# override is only here to call pytest explicitly so that we exercise
# our pyproject ``[tool.pytest.ini_options]`` configuration.
override_dh_auto_test:
	PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src \
	    python3 -m pytest -q

# Tell dh_installchangelogs about the upstream changelog so it gets
# installed as ``changelog.gz`` rather than ``CHANGELOG.md`` (lintian:
# wrong-name-for-upstream-changelog).
override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
